# Jarvis admin auth (required for /admin/jarvis)
JARVIS_ADMIN_PASSWORD=
JARVIS_SESSION_SECRET=

# Google OAuth — Gmail API (required for Gmail connect buttons)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: canonical app URL for OAuth redirect (defaults to https://swlremovals.co.uk in production)
# JARVIS_APP_URL=https://swlremovals.co.uk

# Vercel KV — auto-populated when you link a KV database to the project (Storage → KV)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Sales GPT (OpenAI) — required for Sales GPT mode on /admin/jarvis
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
# JARVIS_SALES_MODEL=gpt-4o-mini
# Set to false to disable Sales GPT without removing the API key
# JARVIS_SALES_GPT_ENABLED=true
